{
  "entities": {
    "users": {
      "title": "User",
      "description": "User account and profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "business", "admin"] },
        "provider": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "appointments": {
      "title": "Appointment",
      "description": "Customer bookings and appointments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "userId": { "type": "string" },
        "serviceId": { "type": "string" },
        "staffId": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "businessId", "userId", "serviceId", "date", "startTime"]
    }
  }
}
